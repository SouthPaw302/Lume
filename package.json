{
  "name": "lume-ai",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first developmental companion core and emergence laboratory",
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/*.test.js Lume/embodiment/test/*.test.js",
    "test:core": "node --test test/*.test.js",
    "test:embodiment": "npm --prefix Lume test",
    "check:repo": "node scripts/check-repository.js",
    "experiment:demo": "node scripts/lume-experiment.js",
    "replay": "node scripts/run-replay.js",
    "fixtures:import-history": "node scripts/import-historical-replays.js",
    "oauth:bridge": "node scripts/openclaw-oauth-bridge.js",
    "experiment:trial": "node scripts/run-candidate-trial.js",
    "experiment:prospective": "node scripts/capture-prospective-trial.js",
    "profiles:install": "node scripts/install-hermes-profiles.js",
    "archive:index": "node scripts/index-lume-archive.js",
    "archive:search": "node scripts/search-lume-archive.js",
    "core:context": "node scripts/lume-context.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}
